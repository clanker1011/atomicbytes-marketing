---
layout: base.njk
---

<article class="section-lg">
  <header class="content-narrow">
    <p class="hero-kicker">
      <time datetime="{{ date | isoDate }}">{{ date | dateDisplay }}</time>
      {% if humanMade %}
      · <img src="{{ '/assets/labels/human-sticker.svg' | url }}" alt="Human Made" style="display: inline-block; width: 32px; height: 32px; vertical-align: middle; margin-left: var(--space-8);" width="32" height="32">
      {% endif %}
    </p>
    <h1>{{ title }}</h1>
    {% if description %}
    <p class="lede">{{ description }}</p>
    {% endif %}
  </header>
  
  <div class="post-content section-md">
    {{ content | safe }}
  </div>
  
  <footer class="content-narrow" style="margin-top: var(--space-64); padding-top: var(--space-32); border-top: var(--stroke-thin) solid var(--line);">
    <p><a href="{{ '/blog/' | url }}">← All posts</a></p>
  </footer>
</article>

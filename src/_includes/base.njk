<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | AtomicBytes</title>
  <meta name="description" content="{{ description or 'AtomicBytes builds web and mobile products that feel good to use—and hold up over time. Small-team energy, serious craft.' }}">
  <link rel="stylesheet" href="{{ '/css/tokens.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/marketing.css' | url }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/characters/atomicbyte-mark.svg' | url }}">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,500..700,60,1&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Sixtyfour+Convergence&display=swap" rel="stylesheet">
  
  {% if page.url == "/" %}
  <link rel="alternate" type="application/rss+xml" title="AtomicBytes Blog" href="{{ '/feed.xml' | url }}">
  {% endif %}
</head>
<body class="paper-{{ paperPattern or site.paperPattern or 'grid' }}">
  <a href="#main" class="skip-link">Skip to content</a>
  
  <header class="site-header">
    <div class="header-inner">
      <a href="{{ '/' | url }}" class="header-brand">
        <span class="header-wordmark">AtomicBytes</span>
      </a>
      
      <nav class="header-nav" aria-label="Main navigation">
        <ul class="nav-links">
          <li><a href="{{ '/studio/' | url }}">Studio</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand-block">
        <img src="{{ '/assets/characters/atomicbyte.png' | url }}" alt="AtomicByte character" class="footer-character">
        <div>
          <div class="footer-brand">AtomicBytes</div>
          <p class="footer-tagline">web + mobile studio</p>
        </div>
      </div>
      
      <div>
        <h3 class="footer-heading">Connect</h3>
        <ul class="footer-icon-links">
          <li><a href="mailto:hello@atomicbytes.com" aria-label="Email AtomicBytes"><img src="{{ '/assets/icons/mail.svg' | url }}" alt="" class="footer-icon"></a></li>
          <li><a href="https://x.com/atomic_bytes" target="_blank" rel="noopener noreferrer" aria-label="AtomicBytes on X"><img src="{{ '/assets/icons/x.svg' | url }}" alt="" class="footer-icon"></a></li>
          <li><a href="https://bsky.app/profile/atomicbytes.com" target="_blank" rel="noopener noreferrer" aria-label="AtomicBytes on Bluesky"><img src="{{ '/assets/icons/bluesky.svg' | url }}" alt="" class="footer-icon"></a></li>
          <li><a href="https://www.linkedin.com/in/mwsell/" target="_blank" rel="noopener noreferrer" aria-label="Matt Sell on LinkedIn"><img src="{{ '/assets/icons/linkedin.svg' | url }}" alt="" class="footer-icon"></a></li>
          <li><a href="{{ '/feed.xml' | url }}" aria-label="RSS feed"><img src="{{ '/assets/icons/rss.svg' | url }}" alt="" class="footer-icon"></a></li>
        </ul>
      </div>
    </div>
  </footer>
</body>
</html>
